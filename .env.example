NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slack_bot_aya_hadith_dev?schema=public
ADMIN_API_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Signs the admin dashboard's session cookie. Unrelated to ADMIN_API_KEY, which the dashboard's
# login form still checks against to establish the session.
SESSION_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters

DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_LOCALE=ar

LOG_LEVEL=debug

# Leave blank and the application still boots: content, review, preview and health all work.
# Slack endpoints return 503 until a workspace has completed the OAuth install below (every
# workspace's bot token lives encrypted in its SlackWorkspace row — there is no env-var token).
SLACK_APP_TOKEN=

# Public "Add to Slack" OAuth install flow (src/slack-oauth/). All three optional: leave blank
# and the app still boots, but GET /slack/install and /slack/oauth/callback return a
# not-configured error. Get CLIENT_ID/CLIENT_SECRET from your Slack app's "Basic Information"
# page. The OAuth redirect URL registered on that page must be
# `${APP_BASE_URL}/api/v1/slack/oauth/callback` (routes sit behind the global `api/v1` prefix
# like everything else in this app). Generate the encryption key with `openssl rand -base64 32`
# — it must decode to exactly 32 bytes.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TOKEN_ENCRYPTION_KEY=

# Phase 4: optional until scheduling is implemented. Disabled by default.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=5
SCHEDULER_LOCK_ID=874321

# All optional: leave blank and the application still boots; the import endpoint returns 503
# QURAN_FOUNDATION_NOT_CONFIGURED instead. Client credentials grant only (no user/PKCE flow) —
# get CLIENT_ID/CLIENT_SECRET from your Quran.Foundation dashboard. Verified live: a dashboard
# app's credentials work against the `production` OAuth/API hosts even before requesting
# prelive/sandbox access separately — set ENV to whichever host your credentials actually work
# against (401 invalid_client means "wrong host", not "wrong credentials").
# RESOURCE_IDs pin which translation/tafsir to import; resolved via GET
# /content/api/v4/resources/translations|tafsirs. 20 = Saheeh International (English) and
# 169 = Ibn Kathir (Abridged, English) are reasonable, verified-working defaults.
# This client is import-only: the runtime scheduler must never call it to construct a delivery
# (PLAN.md §2.1).
QURAN_FOUNDATION_ENV=production
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
QURAN_FOUNDATION_TRANSLATION_RESOURCE_ID=20
QURAN_FOUNDATION_TAFSIR_RESOURCE_ID=169

# Shifts the application's idea of "now" by this many seconds, so per-subscriber scheduling can
# be exercised without waiting for real time to pass. Startup FAILS if this is non-zero while
# NODE_ENV=production. Leave at 0 unless actively verifying scheduling behavior.
CLOCK_OFFSET_SECONDS=0

SWAGGER_ENABLED=false
