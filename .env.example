NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slack_bot_aya_hadith_dev?schema=public
ADMIN_API_KEY=replace-with-a-long-random-secret-at-least-32-characters

DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_LOCALE=ar

LOG_LEVEL=debug

# Both are required for any Slack operation. Leave them blank and the application still boots:
# content, review, preview and health all work, and Slack endpoints return 503
# SLACK_NOT_CONFIGURED. SLACK_TOKEN_SECRET_KEY is an alias, never a credential, and must match
# the `tokenSecretKey` stored on the SlackWorkspace row. Scopes: chat:write to post, plus
# channels:read (public) or groups:read (private) to verify a channel.
SLACK_BOT_TOKEN=
SLACK_TOKEN_SECRET_KEY=primary-slack-bot-token
SLACK_APP_TOKEN=

# Phase 4: optional until scheduling is implemented. Disabled by default.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=5
SCHEDULER_LOCK_ID=874321

SWAGGER_ENABLED=false
