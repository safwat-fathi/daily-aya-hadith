<%- include('../_layout/_header', { title, activeNav, flash }) %>

<div class="page-header">
  <h1>Import from HadeethEnc</h1>
</div>

<div class="card">
  <% if (next) { %>
    <p>Next up: category <strong><%= next.categoryTitleArabic %></strong> (<%= next.categoryTitleEnglish %>) — page <%= next.page %>, item <%= next.itemIndex + 1 %></p>
    <p class="hint">The exact hadith at this position isn't known until import runs — an empty page at this position is skipped forward automatically.</p>
  <% } else { %>
    <p class="muted">Could not reach HadeethEnc to determine the next position — check connectivity and try again.</p>
  <% } %>
  <p class="hint">Imports Arabic+English hadiths from HadeethEnc's full category tree, skipping any hadith missing an English translation and any hadith whose own grade is flagged as weak or disputed. Imported items are stored already approved — validated against the same strict rules a human approval would apply. A hadith that fails that validation (e.g. missing Arabic text) is reported as an error instead of being created.</p>
</div>

<form method="POST" action="/api/v1/admin/hadith-import" class="card">
  <div class="field">
    <label for="count">How many hadiths</label>
    <input type="number" id="count" name="count" min="1" max="100" value="1" />
    <p class="hint">Larger batches take longer to import — the page will wait until it finishes. If the browser times out, hadiths already imported are safe; re-submitting continues from where it left off rather than retrying.</p>
  </div>

  <button type="submit" class="primary">Import</button>
</form>

<%- include('../_layout/_footer') %>
