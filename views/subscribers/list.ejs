<%- include('../_layout/_header', { title, activeNav, flash }) %>

<div class="page-header">
  <h1>Subscribers</h1>
  <a class="btn primary" href="/api/v1/admin/subscribers/new">+ New subscriber</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table>
      <thead><tr><th>Slack user ID</th><th>Workspace</th><th>Timezone</th><th>Locale</th><th>Active</th></tr></thead>
      <tbody>
        <% items.forEach(function (sub) { %>
          <tr>
            <td><a href="/api/v1/admin/subscribers/<%= sub.id %>"><%= sub.slackUserId %></a></td>
            <td><%= sub.workspaceId %></td>
            <td><%= sub.timezone %></td>
            <td><%= sub.locale %></td>
            <td><%= sub.isActive ? 'Yes' : 'No' %></td>
          </tr>
        <% }) %>
        <% if (items.length === 0) { %>
          <tr><td colspan="5" class="muted">No subscribers yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <%- include('../partials/_pagination', { pagination, basePath }) %>
</div>

<%- include('../_layout/_footer') %>
