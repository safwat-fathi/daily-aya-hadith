<div class="field">
  <label for="arabicText">Arabic text</label>
  <textarea id="arabicText" name="payload[arabicText]" dir="rtl"><%= payload.arabicText || '' %></textarea>
</div>
<div class="field">
  <label for="translation">Translation</label>
  <textarea id="translation" name="payload[translation]"><%= payload.translation || '' %></textarea>
</div>
<div class="field">
  <label for="narrator">Narrator</label>
  <input type="text" id="narrator" name="payload[narrator]" value="<%= payload.narrator || '' %>" />
</div>
<div class="field">
  <label for="collection">Collection</label>
  <input type="text" id="collection" name="payload[collection]" value="<%= payload.collection || '' %>" />
</div>
<div class="field">
  <label for="book">Book</label>
  <input type="text" id="book" name="payload[book]" value="<%= payload.book || '' %>" />
</div>
<div class="field">
  <label for="hadithNumber">Hadith number</label>
  <input type="text" id="hadithNumber" name="payload[hadithNumber]" value="<%= payload.hadithNumber || '' %>" />
</div>
<div class="field">
  <label for="grade">Grade</label>
  <input type="text" id="grade" name="payload[grade]" value="<%= payload.grade || '' %>" />
</div>
<div class="field">
  <label for="grader">Grader</label>
  <input type="text" id="grader" name="payload[grader]" value="<%= payload.grader || '' %>" />
</div>
<div class="field">
  <label for="conciseExplanation">Explanation (Arabic)</label>
  <textarea id="conciseExplanation" name="payload[conciseExplanation]"><%= payload.conciseExplanation || '' %></textarea>
</div>
<div class="field">
  <label for="conciseExplanationTranslation">Explanation (English)</label>
  <textarea id="conciseExplanationTranslation" name="payload[conciseExplanationTranslation]"><%= payload.conciseExplanationTranslation || '' %></textarea>
</div>
<fieldset>
  <legend>Lessons — Arabic (up to 5 shown)</legend>
  <% for (var lessonIndex = 0; lessonIndex < 5; lessonIndex++) { var lesson = (payload.lessons && payload.lessons[lessonIndex]) || ''; %>
    <div class="field">
      <input type="text" name="payload[lessons][]" value="<%= lesson %>" dir="rtl" />
    </div>
  <% } %>
</fieldset>
<fieldset>
  <legend>Lessons — English (up to 5 shown)</legend>
  <% for (var lessonTIndex = 0; lessonTIndex < 5; lessonTIndex++) { var lessonT = (payload.lessonsTranslation && payload.lessonsTranslation[lessonTIndex]) || ''; %>
    <div class="field">
      <input type="text" name="payload[lessonsTranslation][]" value="<%= lessonT %>" />
    </div>
  <% } %>
</fieldset>
<div class="field">
  <label for="reflection">Reflection</label>
  <textarea id="reflection" name="payload[reflection]"><%= payload.reflection || '' %></textarea>
</div>
<div class="field">
  <label for="practicalAction">Practical action</label>
  <textarea id="practicalAction" name="payload[practicalAction]"><%= payload.practicalAction || '' %></textarea>
</div>
